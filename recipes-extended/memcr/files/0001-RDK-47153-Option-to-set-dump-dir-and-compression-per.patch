 	if (checkpoint) {
 		fprintf(stdout, "Will checkpoint %d.\n", pid);
-		ret = memcr_client_checkpoint(cd, pid);
+
+		cd = memcr_client_connect(comm_location);
+		if (cd < 0) {
+			fprintf(stderr, "Connection creation failed!\n");
+			return cd;
+		}
