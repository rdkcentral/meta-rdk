###############################################################################
## Monit control file
###############################################################################
##
## Comments begin with a '#' and extend through the end of the line. Keywords
## are case insensitive. All paths MUST BE FULLY QUALIFIED, starting with '/'.
##
## Below you will find examples of some frequently used statements. For
## information about the control file and a complete list of statements and
## options, please have a look in the Monit manual.
##
##
###############################################################################
## Global section
###############################################################################
##
## Start Monit in the background (run as a daemon):
#
set daemon  1              # check services at 1 second interval
#   with start delay 240    # optional: delay the first check by 4-minutes (by
#                           # default Monit check immediately after Monit start)
#
#

# set monit files in temporary locations
set pidfile /var/run/monit.pid
set statefile /var/run/.monit.state
set idfile /var/run/.monit.id

## Set syslog logging. If you want to log to a standalone log file instead,
## specify the full path to the log file
#
set log /opt/logs/monit.log

###############################################################################
# System monitoring
###############################################################################

check system localhost

###############################################################################
## Includes
###############################################################################
##
## It is possible to include additional configuration parts from other files or
## directories.
##
## Enable the include below only when /etc/monit.d exists on the target system.
# include /etc/monit.d/*

